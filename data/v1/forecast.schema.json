                },
                "comparison_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "protocol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "primary_window_count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "overall",
                "by_horizon",
                "comparison_id",
                "protocol",
                "primary_window_count"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_bounds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "target_semantics": {
          "const": "hourly interval end; complete future intervals only"
        },
        "selection": {
          "type": "object",
          "properties": {
            "preferred_method": {
              "const": "NaiveBaseline"
            },
            "missing_reference_hours": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "fallback_reasons": {
              "type": "array",
              "items": {
                "enum": [
                  "missing_observation",
                  "invalid_source_quality",
                  "invalid_observation",
                  "invalid_or_future_timestamp",
                  "stale_observation",
                  "missing_or_invalid_model_context",
                  "generation_failure"
                ]
              }
            }
          },
          "required": [
            "preferred_method",
            "missing_reference_hours",
            "fallback_reasons"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "forecast_origin",
        "observed_at",
        "observed_occupancy",
        "model_name",
        "model_version",
        "model_status",
        "forecast_status",
        "method",
        "readiness",
        "freshness",
        "horizon_hours",
        "predictions",
        "evaluation_summary",
        "warnings",
        "input_bounds",
        "target_semantics"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "model_status": {
                "const": "experimental"
              },
              "model_name": {
                "enum": [
                  "NaiveBaseline",
                  "LastObservationPersistence"
                ]
              },
              "model_version": {
                "const": "baseline-v1"
              },
              "observed_at": {
                "type": "string"
              },
              "observed_occupancy": {
                "type": "number"
              },
              "input_bounds": {
                "type": "array"
              },
              "readiness": {
                "properties": {
                  "ready": {
                    "const": true
                  },
                  "reasons": {
                    "maxItems": 0
                  }
                }
              },
              "freshness": {
                "properties": {
                  "source_age_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 900
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "model_name": {
                "type": "null"
              },
              "model_version": {
                "type": "null"
              },
              "input_bounds": {
                "type": "null"
              },
              "evaluation_summary": {
                "type": "null"
              },
              "predictions": {
                "maxItems": 0
              },
              "model_status": {
                "const": "unavailable"
              },
              "readiness": {
                "properties": {
                  "ready": {
                    "const": false
                  },
                  "reasons": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "NaiveBaseline"
              }
            }
          },
          "then": {
            "properties": {
              "model_name": {
                "enum": [
                  "NaiveBaseline",
                  null
                ]
              },
              "readiness": {
                "properties": {
                  "required_context": {
                    "const": "exact quality hours for requested seasonal targets"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "LastObservationPersistence"
              }
            }
          },
          "then": {
            "properties": {
              "model_name": {
                "enum": [
                  "LastObservationPersistence",
                  null
                ]
              },
              "readiness": {
                "properties": {
                  "required_context": {
                    "const": "fresh actual observation"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "horizon_hours": {
                "const": 1
              },
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "predictions": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "horizon_hours": {
                "const": 6
              },
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "predictions": {
                "minItems": 6,
                "maxItems": 6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "horizon_hours": {
                "const": 12
              },
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "predictions": {
                "minItems": 12,
                "maxItems": 12
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "horizon_hours": {
                "const": 24
              },
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "predictions": {
                "minItems": 24,
                "maxItems": 24
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forecast_status": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "freshness": {
                "properties": {
                  "source_age_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 900
                  }
                }
              },
              "readiness": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "stale_observation"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forecast_status": {
                "const": "insufficient_data"
              }
            }
          },
          "then": {
            "properties": {
              "freshness": {
                "properties": {
                  "source_age_seconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "maximum": 900
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forecast_status": {
                "const": "generation_failure"
              }
            }
          },
          "then": {
            "properties": {
              "readiness": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "generation_failure"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readiness": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "stale_observation"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "freshness": {
                "properties": {
                  "source_age_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 900
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readiness": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "generation_failure"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "forecast_status": {
                "const": "generation_failure"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "horizon_hours": {
                "const": 3
              },
              "forecast_status": {
                "const": "experimental_available"
              }
            }
          },
          "then": {
            "properties": {
              "predictions": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      ]
    }
  }
}
